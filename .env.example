# Copy to .env (gitignored) and fill in. Real env vars override these.

# Enables LLM-written answers; without it EURAG quotes sources verbatim.
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown)
# Answer model: claude-sonnet-5 default ($3/$15 per MTok vs Opus $5/$25);
# claude-haiku-4-5 ($1/$5) works too but hedges more on legal nuance,
# claude-opus-4-8 for maximum answer quality.
# EURAG_LLM_MODEL=claude-sonnet-5
# Low-confidence cascade: when the answer signals insufficient sources,
# retry once with this model over wider retrieval ("none" disables).
# EURAG_ESCALATION_MODEL=claude-opus-4-8
# EURAG_ESCALATION_TOP_K=12
# EURAG_EMBEDDER=fastembed
# Embedding model (must match what the store was seeded with — changing it
# needs a full reseed, or queries and chunks land in different vector spaces).
# EURAG_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# EURAG_DATA_DIR=var
# EURAG_TOP_K=6
# QDRANT_URL=
# Cross-encoder reranker ("none" disables; adds ~1s/query, +6pp phrase_hit)
# EURAG_RERANKER=Xenova/ms-marco-MiniLM-L-6-v2
# Cross-encoder forward-pass batch size. Caps peak memory, not quality: every
# harness metric is identical from 4 to 64. fastembed's own default (64) sends
# the whole pool through at once, which allocated 1.6GB on the escalation path
# (60 candidates) and OOM-killed the api container on a 4GB host. Raise only on
# a large host, and lower it if you raise EURAG_ESCALATION_TOP_K.
# EURAG_RERANK_BATCH=8
# HyDE query expansion via a cheap model ("none" disables; one Haiku call
# per query, lifts multi-topic question retrieval 67%->100%)
# EURAG_HYDE_MODEL=claude-haiku-4-5
# Follow-up contextualisation ("none" disables). Rewrites a follow-up into a
# standalone question before retrieval, using prior turns: "what if I have 29
# people?" otherwise retrieves on the only headcount in the corpus (Pay
# Transparency) instead of the GDPR thread it belongs to. One Haiku call, and
# only on questions that carry history — first questions are untouched.
# Measured: doc_hit 94%->100%, phrase_hit 87%->94% over the golden set.
# EURAG_CONTEXTUALIZE_MODEL=claude-haiku-4-5
# Multi-hop query decomposition (measured: no gain over HyDE — off by default)
# EURAG_DECOMPOSE_MODEL=none

# --- Security spine (M3) — all off by default = local single-user mode ---
# Require JWT auth and isolate each user's uploads into a private tenant.
# Turn on for multi-user; set a strong JWT secret alongside it.
# EURAG_AUTH_ENABLED=true
# EURAG_JWT_SECRET=<64+ random chars — openssl rand -hex 32>
# AES-256-GCM at-rest encryption of chunk text (64 hex chars = 32 bytes).
# Generate: openssl rand -hex 32
# EURAG_ENCRYPTION_KEY=<64 hex chars>
# PII gate backend for uploads: regex (default, stdlib) or presidio (NER).
# EURAG_PII_BACKEND=regex
# Rate limit on /query and /ingest per client (user or IP). 0 disables.
# Applied at startup — changing it needs a process restart.
# EURAG_RATE_LIMIT_PER_MIN=30
# EURAG_RATE_LIMIT_BURST=10

# --- Access tiers (cost control; see docs/SECURITY.md) ---
# Anonymous users get this many full-quality questions (server-enforced per
# IP/day) before a login wall.
# EURAG_FREE_ANON_QUESTIONS=2
# Model the logged-in free tier uses (BYOK users get the full cascade instead).
# EURAG_FREE_MODEL=claude-haiku-4-5
# BYOK requires EURAG_ENCRYPTION_KEY (above) to store users' keys encrypted.
# Cloudflare Turnstile — bot gate on anonymous questions and registration.
# Secret unset = check off; sitekey unset = no widget in the web app (served
# at runtime via /healthz, so rotating keys needs no rebuild). For local
# testing use Cloudflare's universal test keys: sitekey 1x00000000000000000000AA
# (always passes) with secret 1x0000000000000000000000000000000AA, or secret
# 2x0000000000000000000000000000000AA to force rejection.
# EURAG_TURNSTILE_SITEKEY=
# EURAG_TURNSTILE_SECRET=

# --- Multi-instance / production (see docs/DEPLOY.md) ---
# Shared Postgres for users, sessions, audit, and saved chats (required to
# run more than one API instance). Unset = local SQLite.
# EURAG_DATABASE_URL=postgresql://eurag:PASSWORD@postgres:5432/eurag
# Shared Redis for rate-limit buckets across instances. Unset = in-process.
# EURAG_REDIS_URL=redis://redis:6379/0
# Qdrant server instead of embedded (shared vectors across instances).
# QDRANT_URL=http://qdrant:6333
# Trust X-Forwarded-For for the rate-limit key and the anonymous quota key.
# Set true ONLY when nothing can reach the API except a reverse proxy that
# rewrites the header (the prod compose Caddy does; it is set there already).
# On a directly reachable API this would let a client forge unlimited quota.
# EURAG_TRUST_PROXY=false
# CORS origins for a split frontend/API dev setup (comma-separated).
# EURAG_CORS_ORIGINS=http://localhost:3000
# Fail loudly instead of degrading silently (recommended in production): an
# embedder that can't load its model raises instead of falling back to the hash
# embedder (same vector dimension, undetectable, poisons a shared Qdrant), and
# a failed seed kills the container instead of serving the 4 sample documents.
# EURAG_STRICT_BOOT=false
# Production compose secrets:
# POSTGRES_PASSWORD=
# EURAG_DOMAIN=eurag.example.com
# Corpus size the one-shot seeder must reach or the deploy fails (see DEPLOY.md).
# EURAG_EXPECT_DOCS=47
